@* 
// Họ và tên: Nguyễn Thị Hương
// Mã sinh viên: 23103100067
// Nội dung thực hiện: Xây dựng Controller Dashboard Quản trị, Phân hệ Quản lý mượn trả sách (Duyệt đơn, Trả sách, Hủy phiếu) và Thống kê báo cáo dữ liệu.
*@

@model QUANLYTHUVIEN_UNETI_Nhom05__DHTI17A2ND.Models.PhieuMuon
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Chi tiết phiếu mượn";
    bool isAdmin = Context.Session.GetString("VaiTro") == "Admin" || Context.Session.GetString("TenDangNhap") == "admin";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow-lg border-0 rounded-3" style="background: rgba(255, 255, 255, 0.95);">
        <div class="card-header bg-info text-white py-3">
            <h4 class="m-0 fw-bold"><i class="bi bi-info-circle me-2"></i>CHI TIẾT PHIẾU MƯỢN #PM-@Model.MaPhieuMuon</h4>
        </div>
        <div class="card-body p-4">
            <div class="row mb-3">
                <div class="col-md-6">
                    <p class="mb-1 fw-bold text-muted">Tên Độc giả:</p>
                    <h5 class="fw-bold text-dark">@(Model.DocGia?.HoTen ?? "N/A")</h5>
                </div>
                <div class="col-md-6">
                    <p class="mb-1 fw-bold text-muted">Trạng thái:</p>
                    <h5>
                        @if (Model.TrangThai == "Chờ xác nhận")
                        {
                            <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                        }
                        else if (Model.TrangThai == "Đang mượn")
                        {
                            <span class="badge bg-primary">Đang mượn</span>
                        }
                        else if (Model.TrangThai == "Đã trả")
                        {
                            <span class="badge bg-success">Đã trả</span>
                        }
                        else if (Model.TrangThai == "Đã mua")
                        {
                            <span class="badge bg-info text-dark">Đã mua</span>
                        }
                        else if (Model.TrangThai == "Đã hủy")
                        {
                            <span class="badge bg-danger">Đã hủy</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.TrangThai</span>
                        }
                    </h5>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <p class="mb-1 fw-bold text-muted">Ngày thực hiện:</p>
                    <p class="fw-bold fs-6">@Model.NgayMuon.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-md-6">
                    <p class="mb-1 fw-bold text-muted">Hạn trả dự kiến:</p>
                    <p class="fw-bold fs-6 text-danger">@((Model.GhiChu != null && Model.GhiChu.ToLower().Contains("mua")) || Model.TrangThai == "Đã mua" ? "Không có" : Model.NgayHenTra.ToString("dd/MM/yyyy"))</p>
                </div>
            </div>

            <div class="mb-4">
                <p class="mb-1 fw-bold text-muted">Ghi chú:</p>
                <p class="fst-italic text-secondary">@(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú" : Model.GhiChu)</p>
            </div>

            <h5 class="fw-bold text-info border-bottom pb-2 mb-3">Danh sách sách trong đơn</h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th style="width: 15%;">Mã sách</th>
                            <th>Tên sách</th>
                            <th style="width: 20%;">Số lượng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ChiTietPhieuMuons != null && Model.ChiTietPhieuMuons.Any())
                        {
                            foreach (var item in Model.ChiTietPhieuMuons)
                            {
                                <tr>
                                    <td class="text-center fw-bold">@item.MaSach</td>
                                    <td>@(item.Sach?.TenSach ?? "N/A")</td>
                                    <td class="text-center fw-bold text-success">@item.SoLuong</td>
                                </tr>
                            }
                        }
                        else if (Model.Sach != null)
                        {
                            <tr>
                                <td class="text-center fw-bold">@Model.MaSach</td>
                                <td>@Model.Sach.TenSach</td>
                                <td class="text-center fw-bold text-success">1</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">Không có chi tiết sách</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- NÚT QUAY LẠI TỰ ĐỘNG NHẬN BIẾT ADMIN HOẶC ĐỘC GIẢ -->
            <div class="d-flex justify-content-end mt-4">
                @if (isAdmin)
                {
                    <a asp-action="Index" class="btn btn-secondary fw-bold px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                }
                else
                {
                    <a asp-action="LichSuMuon" class="btn btn-secondary fw-bold px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                }
            </div>
        </div>
    </div>
</div>