@* 
// Họ và tên: Nguyễn Trung Kiên
// Mã sinh viên: 23274800010
// Nội dung thực hiện: Xây dựng Controller Quản lý Độc giả, Giỏ hàng đa sản phẩm, Form đăng ký mượn/mua sách trực tuyến và hỗ trợ reset mật khẩu.
*@

@model QuanLyThuVien_UNETI05_DHTI17A2ND.Models.PhieuMuon

@{
    ViewData["Title"] = "Xác nhận phiếu đăng ký mượn";
    int soLuongCon = Model?.Sach?.SoLuongCon ?? 1;
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card shadow-lg p-4 border-0 rounded-4" style="background: rgba(255, 255, 255, 0.96);">
        <h3 class="text-primary fw-extrabold text-center mb-4 text-uppercase">
            <i class="bi bi-file-earmark-check me-2"></i>XÁC NHẬN ĐĂNG KÝ
        </h3>

        <form id="formMuonSach" asp-action="TaoPhieuMuon" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maSach" value="@Model.MaSach" />

            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Tên Sách:</label>
                <input type="text" class="form-control bg-white rounded-3 py-2 fw-semibold text-primary" value="@Model.Sach?.TenSach" readonly />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Ngày Đăng Ký:</label>
                    <input type="text" class="form-control bg-white rounded-3 py-2" value="@Model.NgayMuon.ToString("dd/MM/yyyy")" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Hẹn Trả:</label>
                    <select name="ngayHenTra" class="form-select bg-white rounded-3 py-2 text-danger fw-bold cursor-pointer" required>
                        @for (int i = 1; i <= 14; i++)
                        {
                            var ngayHen = DateTime.Now.AddDays(i);
                            <option value="@ngayHen.ToString("yyyy-MM-dd")" selected="@(i == 14)">
                                @ngayHen.ToString("dd/MM/yyyy") (@i ngày)
                            </option>
                        }
                    </select>
                    <div class="form-text text-muted" style="font-size: 11px;">Bấm chọn ngày trả từ 1 đến 14 ngày kể từ hôm nay.</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Số Lượng Mượn:</label>
                <input type="number" id="inputSoLuong" name="soLuong" value="1" min="1" max="@soLuongCon" class="form-control bg-white rounded-3 py-2 fw-bold text-success" required />
                <div class="form-text text-muted">Kho hiện còn <strong>@soLuongCon</strong> cuốn.</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-dark">Ghi Chú:</label>
                <input asp-for="GhiChu" class="form-control bg-white rounded-3 py-2" placeholder="Nhập ghi chú (nếu có)..." />
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <a asp-controller="Sach" asp-action="Index" class="btn btn-secondary fw-bold rounded-3 px-3 py-2">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>

                <div class="d-flex gap-2">
                    <!-- NÚT THÊM VÀO GIỎ (ĐÃ SỬA: LẤY ĐÚNG SỐ LƯỢNG NGƯỜI DÙNG NHẬP) -->
                    <button type="button" onclick="themVaoGioHang('Muon')" class="btn btn-warning text-dark fw-bold rounded-3 px-3 py-2 shadow-sm">
                        <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                    </button>

                    <!-- NÚT XÁC NHẬN MƯỢN NGAY -->
                    <button type="submit" class="btn btn-success fw-bold rounded-3 px-3 py-2 shadow">
                        <i class="bi bi-check-circle me-1"></i> Xác Nhận
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function themVaoGioHang(loai) {
        var maSach = "@Model.MaSach";
        var soLuong = document.getElementById("inputSoLuong").value || 1;
        window.location.href = "/GioHang/ThemVaoGio?maSach=" + maSach + "&soLuong=" + soLuong + "&loaiYeuCau=" + loai;
    }
</script>