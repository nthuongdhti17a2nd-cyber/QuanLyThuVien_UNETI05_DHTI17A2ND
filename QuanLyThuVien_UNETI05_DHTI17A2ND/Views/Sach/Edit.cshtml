@* 
// Họ và tên: Vũ Ngọc Dung
// Mã sinh viên: 23203100033
// Nội dung thực hiện: Xây dựng Controller Quản lý Sách, tích hợp tính năng Tìm kiếm, Lọc thể loại, Sắp xếp, Phân trang và Quản lý hình ảnh sách.
*@

@model QuanLyThuVien_UNETI05_DHTI17A2ND.Models.Sach

@{
    ViewData["Title"] = "Chỉnh sửa Sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center my-4">
    <div class="col-md-9 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>CẬP NHẬT THÔNG TIN SÁCH</h4>
            </div>
            <div class="card-body p-4 bg-light">
                <!-- BỔ SUNG enctype="multipart/form-data" ĐỂ TẢI ẢNH BÌA -->
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaSach" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tên sách <span class="text-danger">*</span></label>
                            <input asp-for="TenSach" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thể loại <span class="text-danger">*</span></label>
                            <select asp-for="MaTheLoai" class="form-select rounded-3" asp-items="ViewBag.MaTheLoai" required></select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tác giả <span class="text-danger">*</span></label>
                            <input asp-for="TacGia" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nhà xuất bản</label>
                            <input asp-for="NhaXuatBan" class="form-control rounded-3" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Năm xuất bản</label>
                            <input asp-for="NamXuatBan" type="number" class="form-control rounded-3" />
                        </div>

                        <!-- ĐÃ FIX LỖI CS1061: ĐỔI TỪ SoLuongTong THÀNH SoLuong -->
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Tổng số lượng <span class="text-danger">*</span></label>
                            <input asp-for="SoLuong" type="number" min="0" class="form-control rounded-3" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Số lượng còn <span class="text-danger">*</span></label>
                            <input asp-for="SoLuongCon" type="number" min="0" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Giá sách (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="GiaSach" type="number" step="1000" class="form-control rounded-3" required />
                        </div>

                        <!-- THÊM Ô CHỌN SỬA HÌNH ẢNH BÌA SÁCH MỚI -->
                        <div class="col-md-12">
                            <label class="form-label fw-bold text-dark">Sửa Ảnh Bìa Sách (Bỏ qua nếu giữ nguyên ảnh cũ):</label>
                            <input type="file" name="fHinhAnh" class="form-control rounded-3" accept="image/*" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning text-dark rounded-pill px-5 fw-bold shadow">
                            <i class="bi bi-save me-1"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>