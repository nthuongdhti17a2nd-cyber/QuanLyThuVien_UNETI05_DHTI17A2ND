@* 
// Họ và tên: Phạm Thị Thùy Linh
// Mã sinh viên: 23103100005
// Nội dung thực hiện: Xây dựng Controller Quản lý Tài khoản, Đăng nhập, Phân quyền hệ thống, Quản lý Thể loại sách và Dịch vụ gửi Email tự động.
*@
@{
    ViewData["Title"] = "Quên mật khẩu";

    // Tạo ngẫu nhiên 1 chuỗi 5 ký tự gồm Chữ in hoa A-Z và Số 0-9
    var random = new Random();
    const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    var randomCode = new string(Enumerable.Repeat(chars, 5).Select(s => s[random.Next(s.Length)]).ToArray());

    // Lưu mã xác thực ngẫu nhiên vào Session để Controller kiểm tra khi Submit
    Context.Session.SetString("ResetCode", randomCode);

    var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={randomCode}";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-warning text-dark text-center py-3">
                    <h3 class="fw-bold mb-0"><i class="bi bi-key-fill me-2"></i>QUÊN MẬT KHẨU</h3>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.Error</div>
                    }

                    <div class="text-center mb-4">
                        <small class="text-muted d-block mb-2">Quét mã QR dưới đây bằng điện thoại để lấy **Mã xác thực độc quyền**:</small>
                        <img src="@qrUrl" alt="Mã QR Xác thực" class="img-thumbnail shadow-sm p-2" style="width: 180px; height: 180px;" />
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên đăng nhập</label>
                            <input type="text" name="tenDangNhap" class="form-control" placeholder="" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã xác thực (từ mã QR)</label>
                            <input type="text" name="maXacThuc" class="form-control" placeholder="" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mật khẩu mới</label>
                            <input type="password" name="matKhauMoi" class="form-control" placeholder="" required />
                        </div>

                        <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mt-2 text-dark">
                            <i class="bi bi-arrow-repeat me-1"></i> Khôi Phục Mật Khẩu
                        </button>

                        <div class="text-center mt-3">
                            <a asp-action="Login" class="text-decoration-none text-primary">Quay lại Đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>