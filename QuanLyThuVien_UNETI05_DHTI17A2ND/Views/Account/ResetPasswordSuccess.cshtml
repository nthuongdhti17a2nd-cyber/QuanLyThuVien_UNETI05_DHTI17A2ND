@* 
Họ và tên: Phạm Thị Thùy Linh
Mã sinh viên: 23103100005
Nội dung thực hiện: Giao diện thông báo đổi mật khẩu thành công kèm đếm ngược 10 giây tự động về trang đăng nhập *@

@{
    ViewData["Title"] = "Đổi mật khẩu thành công";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 text-center">
            <div class="card shadow-lg border-0 rounded-4 p-4" style="background: rgba(255, 255, 255, 0.98);">
                <div class="card-body">
                    <!-- Icon thành công -->
                    <div class="mb-3 text-success">
                        <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
                    </div>

                    <h3 class="fw-bold text-success mb-3">ĐỔI MẬT KHẨU THÀNH CÔNG!</h3>

                    <p class="text-muted mb-4">
                        Tài khoản của bạn đã được cập nhật mật khẩu mới thành công. Vui lòng đăng nhập lại để tiếp tục sử dụng hệ thống thư viện.
                    </p>

                    <!-- Đồng hồ đếm ngược -->
                    <div class="alert alert-warning py-2 mb-4 fw-semibold rounded-3">
                        Tự động chuyển về trang đăng nhập sau <span id="countdown" class="text-danger fw-bold fs-5">10</span> giây...
                    </div>

                    <!-- Nút quay lại thủ công -->
                    <div class="d-grid">
                        <a asp-action="Login" class="btn btn-primary fw-bold py-2 rounded-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Quay lại trang đăng nhập ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Thiết lập thời gian đếm ngược 10 giây
        var seconds = 10;
        var countdownTimer = setInterval(function () {
            seconds--;
            document.getElementById("countdown").innerText = seconds;

            if (seconds <= 0) {
                clearInterval(countdownTimer);
                // Tự động chuyển hướng về trang Login
                window.location.href = '@Url.Action("Login", "Account")';
            }
        }, 1000);
    </script>
}