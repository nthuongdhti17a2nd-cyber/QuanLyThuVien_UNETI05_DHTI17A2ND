@* 
// Họ và tên: Nguyễn Thị Hương
// Mã sinh viên: 23103100067
// Nội dung thực hiện: Xây dựng Controller Dashboard Quản trị, Phân hệ Quản lý mượn trả sách (Duyệt đơn, Trả sách, Hủy phiếu) và Thống kê báo cáo dữ liệu.
*@
@{
    ViewData["Title"] = "Trang Quản Trị Hệ Thống";
}

<div class="container my-4 text-center">
    <!-- BỌC KHUNG NỀN TRẮNG CHO TIÊU ĐỀ -->
    <div class="card shadow-lg p-4 mb-4 mx-auto border-0 text-center rounded-4 opacity-95 bg-white" style="max-width: 850px;">
        <h2 class="fw-bold text-success mb-2 text-uppercase">
            <i class="bi bi-speedometer2 me-2"></i>BẢNG QUẢN TRỊ HỆ THỐNG THƯ VIỆN
        </h2>
        <p class="text-muted mb-0">Chào mừng Quản trị viên! Vui lòng chọn chức năng quản lý bên dưới.</p>
    </div>

    <!-- 5 CHỨC NĂNG CHÍNH DÀN BỐ CỤC 3 TRÊN - 2 DƯỚI -->
    <div class="row g-4 mx-auto" style="max-width: 950px;">
        <!-- HÀNG 1: 3 CHỨC NĂNG -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center p-3 rounded-4 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 text-primary mb-2"><i class="bi bi-journal-bookmark-fill"></i></div>
                        <h5 class="card-title fw-bold">Quản lý Sách</h5>
                        <p class="card-text text-muted small">Thêm, sửa, xóa và cập nhật số lượng danh mục sách.</p>
                    </div>
                    <a asp-controller="Sach" asp-action="Index" class="btn btn-primary fw-bold w-100 rounded-3 mt-3">Truy cập</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center p-3 rounded-4 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 text-success mb-2"><i class="bi bi-tags-fill"></i></div>
                        <h5 class="card-title fw-bold">Quản lý Thể loại</h5>
                        <p class="card-text text-muted small">Phân loại danh mục sách, quản lý trạng thái thể loại.</p>
                    </div>
                    <a asp-controller="TheLoai" asp-action="Index" class="btn btn-success fw-bold w-100 rounded-3 mt-3">Truy cập</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center p-3 rounded-4 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 text-info mb-2"><i class="bi bi-people-fill"></i></div>
                        <h5 class="card-title fw-bold">Quản lý Độc giả</h5>
                        <p class="card-text text-muted small">Xem danh sách, cấp tài khoản và quản lý thông tin độc giả.</p>
                    </div>
                    <a asp-controller="DocGia" asp-action="Index" class="btn btn-info text-white fw-bold w-100 rounded-3 mt-3">Truy cập</a>
                </div>
            </div>
        </div>

        <!-- HÀNG 2: 2 CHỨC NĂNG CÂN ĐỐI -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 text-center p-3 rounded-4 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 text-warning mb-2"><i class="bi bi-card-checklist"></i></div>
                        <h5 class="card-title fw-bold">Quản lý Mượn / Trả</h5>
                        <p class="card-text text-muted small">Duyệt phiếu mượn, xác nhận trả sách và xử lý vi phạm.</p>
                    </div>
                    <a asp-controller="PhieuMuon" asp-action="Index" class="btn btn-warning text-dark fw-bold w-100 rounded-3 mt-3">Truy cập</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 text-center p-3 rounded-4 bg-white">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="fs-1 text-danger mb-2"><i class="bi bi-bar-chart-line-fill"></i></div>
                        <h5 class="card-title fw-bold">Thống kê & Báo cáo</h5>
                        <p class="card-text text-muted small">Xem báo cáo lượt mượn, sách tồn và tình trạng thư viện.</p>
                    </div>
                    <a asp-controller="Admin" asp-action="ThongKeBaoCao" class="btn btn-danger fw-bold w-100 rounded-3 mt-3">Truy cập</a>
                </div>
            </div>
        </div>
    </div>
</div>