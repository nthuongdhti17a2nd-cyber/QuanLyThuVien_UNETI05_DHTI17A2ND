@* 
// Họ và tên: Nguyễn Trung Kiên
// Mã sinh viên: 23274800010
// Nội dung thực hiện: Xây dựng Controller Quản lý Độc giả, Giỏ hàng đa sản phẩm, Form đăng ký mượn/mua sách trực tuyến và hỗ trợ reset mật khẩu.
*@
@model IEnumerable<QuanLyThuVien_UNETI05_DHTI17A2ND.Controllers.CartItem>

@{
    ViewData["Title"] = "Giỏ Sách Đã Chọn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool hasMua = Model != null && Model.Any(x => x.LoaiYeuCau == "Mua");
}

<div class="container my-5 position-relative" style="min-height: 75vh;">

    <!-- TIÊU ĐỀ NỀN TRẮNG BO TRÒN -->
    <div class="d-flex align-items-center justify-content-between mb-4 p-3 bg-white shadow-sm rounded-3">
        <h2 class="text-success fw-bold m-0">
            <i class="bi bi-cart-check me-2"></i>GIỎ SÁCH CỦA BẠN
        </h2>
        <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
            Tổng cộng: @(Model?.Sum(x => x.SoLuong) ?? 0) cuốn
        </span>
    </div>

    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show fw-bold mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden bg-white">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 35%;">Tên Sách</th>
                                <th style="width: 20%;">Thể Loại</th>
                                <th class="text-center" style="width: 15%;">Loại Yêu Cầu</th>
                                <th class="text-center" style="width: 15%;">Số Lượng</th>
                                <th class="text-center" style="width: 15%;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark fs-6">
                                        <i class="bi bi-book me-2 text-primary"></i>@item.Sach?.TenSach
                                    </td>
                                    <td class="text-secondary fw-semibold">
                                        @(item.Sach?.TheLoai?.TenTheLoai ?? "Chưa phân loại")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge px-3 py-2 @(item.LoaiYeuCau == "Muon" ? "bg-success" : "bg-warning text-dark") fw-bold">
                                            @(item.LoaiYeuCau == "Muon" ? "Mượn Đọc" : "Mua Sách")
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold fs-6 text-primary">@item.SoLuong</td>
                                    <td class="text-center">
                                        <a asp-action="RemoveFromCart" asp-route-id="@item.Sach?.MaSach" asp-route-loai="@item.LoaiYeuCau" class="btn btn-outline-danger btn-sm fw-bold px-3">
                                            <i class="bi bi-trash me-1"></i>Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <form asp-action="Checkout" method="post" class="d-flex justify-content-between align-items-center pt-2 pb-5">
            @Html.AntiForgeryToken()

            <div class="d-flex gap-2">
                <a asp-controller="Sach" asp-action="Index" class="btn btn-secondary fw-bold rounded-3 px-3 py-2 shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i>Chọn thêm sách
                </a>

                <!-- NÚT TRANG CHỦ MÀU XANH NỔI BẬT DỄ NHÌN -->
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-bold rounded-3 px-3 py-2 shadow-sm">
                    <i class="bi bi-house-door-fill me-1"></i>Trang chủ
                </a>
            </div>

            <button type="submit" class="btn btn-success btn-lg fw-bold rounded-3 px-4 py-2 shadow" onclick="return confirm('Xác nhận đăng ký tạo phiếu cho toàn bộ sách trong giỏ?');">
                <i class="bi bi-send-check me-1"></i>Xác Nhận Tạo Phiếu
            </button>
        </form>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mb-5">
            <div class="py-4">
                <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 fw-bold text-dark">Giỏ sách đang trống!</h4>
                <p class="text-muted mb-4">Hãy chọn những cuốn sách hay từ thư viện để đăng ký mượn hoặc mua nhé.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-bold px-4 py-2 rounded-3 shadow-sm">
                        <i class="bi bi-house-door-fill me-1"></i>Về Trang Chủ
                    </a>
                    <a asp-controller="Sach" asp-action="Index" class="btn btn-outline-primary fw-bold px-4 py-2 rounded-3 shadow-sm">
                        <i class="bi bi-book me-1"></i>Xem Danh Sách Sách
                    </a>
                </div>
            </div>
        </div>
    }
</div>