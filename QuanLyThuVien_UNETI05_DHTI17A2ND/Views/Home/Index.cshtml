@* 
Họ và tên: Nguyễn Trung Kiên
Mã sinh viên: 23274800010
Nội dung thực hiện: Trang chủ Hệ thống - Điều hướng chức năng phân quyền Admin & Độc giả
*@

@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var vaiTro = Context.Session.GetString("VaiTro");
    bool isAdmin = vaiTro == "Admin" || tenDangNhap == "admin";
}

<div class="container text-center mt-4 mb-5">
    <div class="card shadow-lg p-4 p-md-5 mx-auto rounded-4 border-0 bg-white opacity-95" style="max-width: 850px;">
        <h1 class="text-primary fw-bold mb-2 text-uppercase">THƯ VIỆN ĐẠI HỌC UNETI</h1>
        <p class="text-muted mb-4">Hệ thống tra cứu sách và đăng ký mượn trực tuyến dành cho Sinh viên & Cán bộ.</p>

        @if (string.IsNullOrEmpty(tenDangNhap))
        {
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Account" asp-action="Login" class="btn btn-success fw-bold px-4 py-2 rounded-3 shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-warning text-dark fw-bold px-4 py-2 rounded-3 shadow-sm">
                    <i class="bi bi-person-plus-fill me-1"></i> Đăng ký tài khoản
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info py-2 fw-bold mb-4 rounded-3 shadow-sm">
                <i class="bi bi-person-check-fill me-1"></i> Xin chào <span class="text-uppercase text-danger">@tenDangNhap</span> (@(isAdmin ? "Admin" : "Độc giả"))
            </div>

            @if (isAdmin)
            {
                <!-- 5 NÚT BẢNG QUẢN TRỊ DÀNH CHO ADMIN (3 NÚT TRÊN - 2 NÚT DƯỚI) -->
                <div class="row g-3">
                    <!-- Hàng 1: 3 Nút -->
                    <div class="col-md-4">
                        <a asp-controller="Sach" asp-action="Index" class="btn btn-outline-primary btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                            <i class="bi bi-journal-bookmark-fill fs-2"></i>
                            <span>Quản lý sách</span>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="TheLoai" asp-action="Index" class="btn btn-outline-success btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                            <i class="bi bi-tags-fill fs-2"></i>
                            <span>Quản lý thể loại</span>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="DocGia" asp-action="Index" class="btn btn-outline-info btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                            <i class="bi bi-people-fill fs-2"></i>
                            <span>Quản lý độc giả</span>
                        </a>
                    </div>

                    <!-- Hàng 2: 2 Nút Cân Bằng -->
                    <div class="col-md-6">
                        <a asp-controller="PhieuMuon" asp-action="Index" class="btn btn-outline-warning text-dark btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                            <i class="bi bi-receipt-cutoff fs-2"></i>
                            <span>Quản lý phiếu mượn</span>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="Admin" asp-action="ThongKeBaoCao" class="btn btn-outline-danger btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold h-100 d-flex flex-column align-items-center justify-content-center gap-1">
                            <i class="bi bi-bar-chart-line-fill fs-2"></i>
                            <span>Thống kê báo cáo</span>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- DÀNH CHO ĐỘC GIẢ -->
                <div class="row g-3 justify-content-center">
                    <div class="col-md-6">
                        <a asp-controller="Sach" asp-action="Index" class="btn btn-outline-primary btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-search fs-3"></i>
                            <span>Tra cứu & Mượn sách</span>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="PhieuMuon" asp-action="LichSuMuon" class="btn btn-outline-success btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-clock-history fs-3"></i>
                            <span>Lịch sử đơn hàng</span>
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>