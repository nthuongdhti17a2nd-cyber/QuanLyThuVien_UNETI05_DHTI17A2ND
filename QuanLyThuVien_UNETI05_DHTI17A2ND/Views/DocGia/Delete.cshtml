@* 
// Họ và tên: Nguyễn Trung Kiên
// Mã sinh viên: 23274800010
// Nội dung thực hiện: Xây dựng Controller Quản lý Độc giả, Giỏ hàng đa sản phẩm, Form đăng ký mượn/mua sách trực tuyến và hỗ trợ reset mật khẩu.
*@
@model QuanLyThuVien_UNETI05_DHTI17A2ND.Models.DocGia

@{
    ViewData["Title"] = "Xóa Độc giả";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0 fs-5"><i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA ĐỘC GIẢ</h4>
            </div>
            <div class="card-body">
                <p class="text-danger fw-bold">Bạn có chắc chắn muốn xóa độc giả này không? Thao tác này không thể hoàn tác!</p>

                <table class="table table-bordered">
                    <tr>
                        <th style="width: 35%;" class="bg-light">Mã độc giả:</th>
                        <td class="fw-bold">@Model.MaDocGia</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Họ và tên:</th>
                        <td>@Model.HoTen</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Email:</th>
                        <td>@Model.Email</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Số điện thoại:</th>
                        <td>@Model.SoDienThoai</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Địa chỉ:</th>
                        <td>@Model.DiaChi</td>
                    </tr>
                </table>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="MaDocGia" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger fw-bold">
                            <i class="bi bi-trash me-1"></i> Xác nhận Xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>