@* 
// Họ và tên: Phạm Thị Thùy Linh
// Mã sinh viên: 23103100005
// Nội dung thực hiện: Xây dựng Controller Quản lý Tài khoản, Đăng nhập, Phân quyền hệ thống, Quản lý Thể loại sách và Dịch vụ gửi Email tự động.
*@

@model IEnumerable<QuanLyThuVien_UNETI05_DHTI17A2ND.Models.TheLoai>

@{
    ViewData["Title"] = "Quản lý Thể loại Sách";
}

<style>
    .title-box-white {
        background: #ffffff;
        border-radius: 16px;
        padding: 10px 24px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        display: inline-flex;
        align-items: center;
    }
</style>

<div class="container my-4">
    <!-- KHU VỰC TIÊU ĐỀ NỀN TRẮNG NỔI BẬT KHÔNG BỊ CHÌM VÀO ẢNH PHÔNG -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary fw-bold shadow-sm rounded-pill px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Trang quản trị
            </a>
            <div class="title-box-white">
                <h3 class="m-0 text-primary fw-extrabold text-uppercase">
                    <i class="bi bi-tags-fill me-2"></i> QUẢN LÝ THỂ LOẠI SÁCH
                </h3>
            </div>
        </div>

        <a asp-action="Create" class="btn btn-success fw-bold shadow-sm rounded-3 px-4 py-2">
            <i class="bi bi-plus-lg me-1"></i> Thêm thể loại mới
        </a>
    </div>

    <!-- KHUNG TÌM KIẾM THỂ LOẠI -->
    <div class="card shadow-sm p-3 mb-4 border-0 rounded-4 bg-white">
        <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 450px;">
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control bg-light border-0" placeholder="Nhập tên thể loại cần tìm..." />
            </div>
            <button type="submit" class="btn btn-primary fw-bold px-3 rounded-3">Tìm kiếm</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
            {
                <a asp-action="Index" class="btn btn-secondary rounded-3">Tải lại</a>
            }
        </form>
    </div>

    <!-- BẢNG DANH SÁCH THỂ LOẠI -->
    <div class="card shadow border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary text-center">
                    <tr>
                        <th class="py-3">Mã thể loại</th>
                        <th class="py-3">Tên thể loại</th>
                        <th class="py-3">Mô tả</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="py-3" width="180px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">@item.MaTheLoai</td>
                                <td><strong>@item.TenTheLoai</strong></td>
                                <td>@item.MoTa</td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success fw-bold px-2 py-1">Đang sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary fw-bold px-2 py-1">Ngừng dùng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.MaTheLoai" class="btn btn-warning btn-sm fw-bold me-1 text-dark rounded-2">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.MaTheLoai" class="btn btn-danger btn-sm fw-bold rounded-2">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Không tìm thấy dữ liệu thể loại nào!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>