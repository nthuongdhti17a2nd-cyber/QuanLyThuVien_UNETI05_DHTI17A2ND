@* 
// Họ và tên: Phạm Thị Thùy Linh
// Mã sinh viên: 23103100005
// Nội dung thực hiện: Xây dựng Controller Quản lý Tài khoản, Đăng nhập, Phân quyền hệ thống, Quản lý Thể loại sách và Dịch vụ gửi Email tự động.
*@
@model IEnumerable<QUANLYTHUVIEN_UNETI_Nhom05__DHTI17A2ND.Models.TheLoai>

@{
    ViewData["Title"] = "Quản lý Thể loại Sách";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary font-weight-bold">QUẢN LÝ THỂ LOẠI SÁCH</h2>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> + Thêm thể loại mới</a>
</div>

<!-- Thanh tìm kiếm -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Nhập tên thể loại cần tìm..." />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
        {
            <a asp-action="Index" class="btn btn-secondary">Xóa tìm</a>
        }
    </div>
</form>

<table class="table table-bordered table-hover align-middle shadow-sm">
    <thead class="table-primary text-center">
        <tr>
            <th>Mã thể loại</th>
            <th>Tên thể loại</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th width="180px">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center font-weight-bold">@item.MaTheLoai</td>
                    <td><strong>@item.TenTheLoai</strong></td>
                    <td>@item.MoTa</td>
                    <td class="text-center">
                        @if (item.TrangThai)
                        {
                            <span class="badge bg-success">Đang sử dụng</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ngừng dùng</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.MaTheLoai" class="btn btn-warning btn-sm me-1">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaTheLoai" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Không tìm thấy dữ liệu thể loại nào!</td>
            </tr>
        }
    </tbody>
</table>
